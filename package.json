{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "prepare": "husky",
    "test:coverage": "dotnet test --collect:\"XPlat Code Coverage\"",
    "test:report": "dotnet tool run reportgenerator -reports:\"tests/**/TestResults/**/coverage.cobertura.xml\" -targetdir:\"coverage-report\" -reporttypes:Html",
    "test:full": "npm run test:coverage && npm run test:report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adrian2422/TaskFlow.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "lint-staged": {
    "*.{cs,cshtml}": "dotnet format --include",
    "*.{html,css,scss,json,md,yaml}": "prettier --write",
    "src/TaskFlow.Web/**/*.{ts,js}": "npm --prefix src/TaskFlow.Web run lint"
  }
}
